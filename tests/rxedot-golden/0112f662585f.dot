digraph rxe {
  graph [rankdir=TB, ordering=out, bgcolor="#ffffff", fontname="Helvetica"];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, margin="0.10,0.05"];
  edge [arrowsize=0.7, color="#888888"];
  labelloc="t"; label=<<FONT FACE="Courier" POINT-SIZE="15">a*b*</FONT>>;
  n0 [shape=box, fillcolor="#333a44", fontcolor="white", style="filled,rounded", label="set\n∞"];
  n1 [label="repeat {0,}\n∞", fillcolor="#d4e4ff", color="#2f60c0", penwidth=2];
  n2 [label="a\n1", fillcolor="#ffffff"];
  n1 -> n2;
  n0 -> n1;
  n3 [label="repeat {0,}\n∞", fillcolor="#d4e4ff", color="#2f60c0", penwidth=2];
  n4 [label="b\n1", fillcolor="#ffffff"];
  n3 -> n4;
  n0 -> n3;
}
