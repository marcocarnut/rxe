digraph rxe {
  graph [rankdir=TB, ordering=out, bgcolor="#ffffff", fontname="Helvetica"];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, margin="0.10,0.05"];
  edge [arrowsize=0.7, color="#888888"];
  n0 [shape=box, fillcolor="#333a44", fontcolor="white", style="filled,rounded", label="set\n2"];
  n1 [label="( )\n2", fillcolor="#eeeeee"];
  n2 [label="[ab]\n2", fillcolor="#ffffff"];
  n1 -> n2;
  n0 -> n1;
  n3 [label="\\1\n1", fillcolor="#ffe0b0"];
  n3 -> n1 [style=dashed, constraint=false, color="#c07000", arrowsize=0.6];
  n0 -> n3;
}
