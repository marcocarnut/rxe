digraph rxe {
  graph [rankdir=TB, ordering=out, bgcolor="#ffffff", fontname="Helvetica"];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, margin="0.10,0.05"];
  edge [arrowsize=0.7, color="#888888"];
  labelloc="t"; label=<<FONT FACE="Courier" POINT-SIZE="15">(\d{3})(?1)</FONT><BR/><FONT COLOR="#d1442a" POINT-SIZE="13">index 5 = 000005</FONT>>;
  n0 [shape=box, fillcolor="#333a44", fontcolor="white", style="filled,rounded", color="#d1442a", penwidth=2.4, label="set\n1000000"];
  n1 [label="( )\n1000\n×1000", fillcolor="#eeeeee", color="#d1442a", penwidth=2.4];
  n2 [label="repeat {3}\n1000\n→ 0 0 0", fillcolor="#d4e4ff", color="#d1442a", penwidth=2.4];
  n3 [label="\\d\n10", fillcolor="#ffffff", color="#d1442a", penwidth=2.4];
  n2 -> n3 [color="#d1442a", penwidth=2.2];
  n1 -> n2 [color="#d1442a", penwidth=2.2];
  n0 -> n1 [color="#d1442a", penwidth=2.2];
  n4 [label="(?1)\n1000", fillcolor="#ffe0b0", color="#d1442a", penwidth=2.4];
  n5 [label="repeat {3}\n1000\n→ 0 0 5", fillcolor="#d4e4ff", color="#d1442a", penwidth=2.4];
  n6 [label="\\d\n10", fillcolor="#ffffff", color="#d1442a", penwidth=2.4];
  n5 -> n6 [color="#d1442a", penwidth=2.2];
  n4 -> n5 [color="#d1442a", penwidth=2.2];
  n0 -> n4 [color="#d1442a", penwidth=2.2];
}
