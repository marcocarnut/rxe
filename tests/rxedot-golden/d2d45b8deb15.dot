digraph rxe {
  graph [rankdir=TB, ordering=out, bgcolor="#ffffff", fontname="Helvetica"];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, margin="0.10,0.05"];
  edge [arrowsize=0.7, color="#888888"];
  labelloc="t"; label=<<FONT FACE="Courier" POINT-SIZE="15">\d{4}-\d{2}-\d{2}</FONT><BR/><FONT COLOR="#d1442a" POINT-SIZE="13">index 5 = 0000-00-05</FONT>>;
  n0 [shape=box, fillcolor="#333a44", fontcolor="white", style="filled,rounded", color="#d1442a", penwidth=2.4, label="set\n100000000"];
  n1 [label="repeat {4}\n10000\n×10000\n→ 0 0 0 0", fillcolor="#d4e4ff", color="#d1442a", penwidth=2.4];
  n2 [label="\\d\n10", fillcolor="#ffffff", color="#d1442a", penwidth=2.4];
  n1 -> n2 [color="#d1442a", penwidth=2.2];
  n0 -> n1 [color="#d1442a", penwidth=2.2];
  n3 [label="-\n1", fillcolor="#ffffff", color="#d1442a", penwidth=2.4];
  n0 -> n3 [color="#d1442a", penwidth=2.2];
  n4 [label="repeat {2}\n100\n×100\n→ 0 0", fillcolor="#d4e4ff", color="#d1442a", penwidth=2.4];
  n5 [label="\\d\n10", fillcolor="#ffffff", color="#d1442a", penwidth=2.4];
  n4 -> n5 [color="#d1442a", penwidth=2.2];
  n0 -> n4 [color="#d1442a", penwidth=2.2];
  n6 [label="-\n1", fillcolor="#ffffff", color="#d1442a", penwidth=2.4];
  n0 -> n6 [color="#d1442a", penwidth=2.2];
  n7 [label="repeat {2}\n100\n→ 0 5", fillcolor="#d4e4ff", color="#d1442a", penwidth=2.4];
  n8 [label="\\d\n10", fillcolor="#ffffff", color="#d1442a", penwidth=2.4];
  n7 -> n8 [color="#d1442a", penwidth=2.2];
  n0 -> n7 [color="#d1442a", penwidth=2.2];
}
