digraph rxe {
  graph [rankdir=TB, ordering=out, bgcolor="#ffffff", fontname="Helvetica"];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, margin="0.10,0.05"];
  edge [arrowsize=0.7, color="#888888"];
  labelloc="t"; label=<<FONT FACE="Courier" POINT-SIZE="15">(?~k:[0-9])</FONT>>;
  n0 [shape=box, fillcolor="#333a44", fontcolor="white", style="filled,rounded", label="set\n10"];
  n1 [label="shuffle (?~…)\n10", fillcolor="#e6d4ff"];
  n2 [label="[0-9]\n10", fillcolor="#ffffff"];
  n1 -> n2;
  n0 -> n1;
}
