digraph rxe {
  graph [rankdir=TB, ordering=out, bgcolor="#ffffff", fontname="Helvetica"];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11, margin="0.10,0.05"];
  edge [arrowsize=0.7, color="#888888"];
  labelloc="t"; label=<<FONT FACE="Courier" POINT-SIZE="15">(cat|dog|fish)</FONT>>;
  n0 [shape=box, fillcolor="#333a44", fontcolor="white", style="filled,rounded", label="set\n3"];
  n1 [label="( )\n3", fillcolor="#eeeeee"];
  n2 [shape=Mrecord, fillcolor="#fff0c0", label="<p0>0\n+1|<p1>1\n+1|<p2>2\n+1"];
  n1 -> n2;
  n3 [label="c\n1", fillcolor="#ffffff"];
  n2:p0 -> n3;
  n4 [label="a\n1", fillcolor="#ffffff"];
  n2:p0 -> n4;
  n5 [label="t\n1", fillcolor="#ffffff"];
  n2:p0 -> n5;
  n6 [label="d\n1", fillcolor="#ffffff"];
  n2:p1 -> n6;
  n7 [label="o\n1", fillcolor="#ffffff"];
  n2:p1 -> n7;
  n8 [label="g\n1", fillcolor="#ffffff"];
  n2:p1 -> n8;
  n9 [label="f\n1", fillcolor="#ffffff"];
  n2:p2 -> n9;
  n10 [label="i\n1", fillcolor="#ffffff"];
  n2:p2 -> n10;
  n11 [label="s\n1", fillcolor="#ffffff"];
  n2:p2 -> n11;
  n12 [label="h\n1", fillcolor="#ffffff"];
  n2:p2 -> n12;
  n0 -> n1;
}
