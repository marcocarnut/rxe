  n0 [shape=box, fillcolor="#333a44", fontcolor="white", style="filled,rounded", color="#d1442a", penwidth=2.4, label="set\n24"];
  n1 [label="repeat {0,2}\n3\n×8", fillcolor="#d4e4ff", color="#d1442a", penwidth=2.4];
