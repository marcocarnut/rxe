  n9 [label="repeat {0,2}\n3", fillcolor="#d4e4ff", color="#d1442a", penwidth=2.4];
  n10 [label="C\n1", fillcolor="#ffffff", color="#d1442a", penwidth=2.4];
  n9 -> n10 [color="#d1442a", penwidth=2.2];
  n4:p2 -> n9 [color="#d1442a", penwidth=2.2];
