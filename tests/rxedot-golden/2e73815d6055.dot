  n3 [label="( )\n8", fillcolor="#eeeeee", color="#d1442a", penwidth=2.4];
  n4 [shape=Mrecord, fillcolor="#fff0c0", color="#d1442a", penwidth=2.4, label="<p0>0\n+3|<p1>3\n+1|<p2>4\n+3|<p3>7\n+1"];
